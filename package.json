{
  "name": "cfnav-independent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --config vite.build.config.mjs --configLoader native && node scripts/prepare-sites-build.mjs",
    "build:cloudflare": "vite build --config vite.build.config.mjs --configLoader native",
    "preview": "vite preview",
    "check:tv": "node scripts/check-tv-health.mjs",
