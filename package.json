    "test:cloudflare": "node --test tests/cloudflare-pages.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "hls.js": "^1.6.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
